{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lottery-machine",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "vars": { "AUTH_ORIGIN": "https://lottery.1eak.cool", "MAIL_FROM": "一刻开奖 <accounts@1eak.cool>" },
  "d1_databases": [{ "binding": "DB", "database_name": "lottery-accounts", "database_id": "731866ec-5a04-4cf7-86cd-14168c2f4dc7", "migrations_dir": "migrations" }],
  "routes": [{ "pattern": "lottery.1eak.cool", "custom_domain": true }],
  "workers_dev": true
}
